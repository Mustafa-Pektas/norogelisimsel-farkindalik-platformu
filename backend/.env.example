# Sunucu Port Numarası
PORT=8000

# Google AI Studio'dan alacağınız ücretsiz API anahtarı:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=BURAYA_GEMINI_API_KEY_YAZIN

# Yeni anlatı endpoint'i için hesabınızda kullanılabilen model kimliği (zorunlu).
# Boşsa yeni endpoint 503 verir; başka modele otomatik geçmez.
SCENARIO_INPUT_MODEL=
# İsteğe bağlı: güncel kart Markdown dosyasının sunucudaki yolu.
# Boşsa proje üstündeki belgeler/Davranis_Kartlari_v02.md okunur.
BEHAVIOR_CARDS_PATH=
