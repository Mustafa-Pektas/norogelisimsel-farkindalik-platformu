# Sunucu Port Numarası
PORT=8000

# development (varsayılan): mevcut yerel yollar korunur.
# deployment: /health, güncel senaryo/klip planı ve /api/compare-scenario ekip deneyi.
# Geçici ortak ekip anahtarı gerekir; kişi/rol sistemi, istek hızı veya HTTPS sağlamaz.
BACKEND_MODE=development

# Deployment için zorunlu; boş bırakılırsa deployment başlangıcı hata verir.
# Sunucu ortamında gizli olarak tanımlayın; gerçek değeri Git'e veya APK'ya koymayın.
# Boşluksuz yazdırılabilir ASCII; istemci Authorization: Bearer başlığında yollar.
TEAM_ACCESS_KEY=

# Yalnız deployment: güncel üretim ve karşılaştırmanın ortak sağlayıcı iş kapasitesi.
# Verilmezse 1; pozitif tam sayı zorunlu. Tek Node süreci içindir, kuyruk yoktur.
GENERATION_MAX_CONCURRENT=1

# Google AI Studio'dan alacağınız ücretsiz API anahtarı:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=BURAYA_GEMINI_API_KEY_YAZIN

# Yeni anlatı endpoint'i için hesabınızda kullanılabilen model kimliği (zorunlu).
# Boşsa yeni endpoint 503 verir; başka modele otomatik geçmez.
SCENARIO_INPUT_MODEL=
# İsteğe bağlı: güncel kart Markdown dosyasının sunucudaki yolu.
# Boşsa backend/resources/Davranis_Kartlari_v02.md okunur (çalışma dizininden bağımsız).
# Açık bir yol verilirse yalnız o yol kullanılır; okunamazsa istek hata verir.
BEHAVIOR_CARDS_PATH=
